{
  "name": "pi-king",
  "version": "0.1.3",
  "description": "Background a Pi session into tmux and come back to it later. A local control plane for long-running Pi sessions. Requires tmux.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "tmux",
    "session",
    "dashboard",
    "persistence",
    "session-manager"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "LICENSE",
    "README.md",
    "bin",
    "docs",
    "hub",
    "media",
    "src",
    "tools"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "video": "./media/demo.mp4",
    "image": "./media/demo.gif"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.0",
    "@earendil-works/pi-tui": ">=0.80.0"
  },
  "bin": {
    "pi-king": "./bin/pi-king",
    "pi-agents": "./bin/pi-king"
  },
  "scripts": {
    "prepublishOnly": "node tools/check-exports.mjs",
    "check": "node tools/check-exports.mjs"
  }
}
